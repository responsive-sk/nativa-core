<?php

declare(strict_types = 1);

/**
 * Rendered via View\ViewRenderer.
 * Variables are provided by the caller; $this is not available.
 *
 * The folder grid above this block is LINKS. Rename and delete are forms, so
 * they live here instead of inside a tile: a `<form>` nested in an `<a>` is
 * invalid HTML that browsers resolve by silently dropping one of the two, and
 * which one they drop depends on the parser.
 *
 * The card reads as a table: the summary is its header, the create form a
 * strip under it, and every folder one row. The rows are rendered by the
 * action (`folderManageRow()`) because each carries its own CSRF field.
 */

if (!isset($viewRendererGuard)) {
    throw new \RuntimeException('Template must be rendered via ViewRenderer.');
}

?>    <!-- OPEN by default: a `<details>` that ships closed is a control nobody
         finds, and the project has already paid for that lesson once (the
         jednotka contents strip painted 25px off-screen inside a closed
         summary). Collapsing is the user's choice, not the default. -->
    <details class="m-card m-folder-manage" open>
        <summary class="m-folder-manage__summary">
            <span class="m-folder-manage__title">Manage folders</span>
            <span class="m-badge m-badge-gray"><?php echo $folderCount; ?></span>
        </summary>
        <form class="m-folder-manage__create" method="post" action="<?php echo $url('media.folder-create'); ?>">
            <?php echo $csrf; ?>
            <label class="m-folder-manage__label" for="folder-new">New folder</label>
            <div class="m-folder-manage__inline">
                <input class="m-input" id="folder-new" type="text" name="path" placeholder="photos/2026" required>
                <button class="m-btn m-btn-primary m-btn-sm" type="submit">Create folder</button>
            </div>
            <p class="m-hint">A folder exists as soon as it is created, even before a file lands in it.</p>
        </form>
        <div class="m-folder-manage__rows"><?php echo $rows; ?></div>
    </details>
