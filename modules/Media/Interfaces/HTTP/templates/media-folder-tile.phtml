<?php

declare(strict_types = 1);

/**
 * Rendered via Modules\Core\Application\Services\View\ViewRenderer.
 * Variables are provided by the caller; $this is not available.
 *
 * One folder tile, shared by the local library and the Cloudinary browser:
 * a folder is a folder on both screens, so it looks the same on both. An
 * image from the folder is the tile, its glyph is the fallback, and the
 * count badge only appears where a count was given.
 *
 * $class, $href, $linkAttrs, $previewUrl, $name and $count arrive already
 * escaped. $linkAttrs carries the caller's extra attributes (the local grid's
 * HTMX swap); '' means the tile is a plain link.
 */

if (!isset($viewRendererGuard)) {
    throw new \RuntimeException('Template must be rendered via ViewRenderer.');
}

?>    <a class="<?php echo $class; ?>" href="<?php echo $href; ?>"<?php echo '' !== $linkAttrs ? ' ' . $linkAttrs : ''; ?>>
        <?php if ('' !== $previewUrl): ?>
        <img class="m-folder-card__thumb" src="<?php echo $previewUrl; ?>" alt="" loading="lazy">
        <?php else: ?>
        <span class="m-folder-card__icon"><?php echo $icon; ?></span>
        <?php endif; ?>
        <span class="m-folder-card__name"><?php echo $name; ?></span>
        <?php if ('' !== $count): ?>
        <span class="m-badge m-badge-gray"><?php echo $count; ?></span>
        <?php endif; ?>
    </a>
