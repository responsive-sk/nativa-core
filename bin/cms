{
    if (!class_exists(\Modules\Blog\Interfaces\CLI\Command\GenerateImagesCommand::class)) {
        fail('generate-images needs the Blog module (bin/cms module:add Blog).');
    }

    $command = new \Modules\Blog\Interfaces\CLI\Command\GenerateImagesCommand();

    exit($command->run(
        array_merge(['generate-images'], array_slice($argv, 2)),
        output(),
    ));
}

