/**
 * Adapt this file's `out()` into the `CliOutput` a command reports through.
 *
 * Built here, in the CLI, so the commands themselves stay free of any printing
 * concern — the same split `SchedulerServices::output()` keeps for the
 * timetable, and the reason a test can drive a command in-process and read what
 * it said.
 *
 * `strip_tags` is not decoration: the migrators' wording is shared with a
 * Console-oriented caller that used to wrap some lines in `<info>`, and
 * printing those tags literally into a crontab mail is worse than no colour.
 * The module commands stopped emitting markup at all, so this only protects
 * the shared migrator text.
 */
function output(): CliOutput
{
    return new class () implements CliOutput {
        public function writeln(string $message): void
        {
            out(strip_tags($message));
        }
    };
}

/**
 * Work one batch of queued jobs — the queue's operator surface.
 *
 * `DatabaseQueue::work()` shipped with exactly one call site in the whole tree:
 * an inline `php` heredoc inside `bin/build/admin-smoke.sh`. So the queue had a
 * worker that no operator could put in crontab, no support answer could point
 * at, and no documentation could describe — the gate was the only place on the
 * planet that could run it. (The end-of-request drain that ships today is the
 * OUTBOX's: a different mechanism, a different database, an idempotent handler.
 * No producer pushes a Queue job yet either, so this command has nothing to
 * deliver until one does — stated rather than papered over.)
 *
 * The handler pairing is wired first, for the reason in the file header.
 *
 * @param list<string> $argv the full argv; options start at index 2
 */
function cmdQueueWork(array $argv): void
{
    if (!class_exists(\Modules\Queue\Interfaces\HTTP\QueueServices::class)) {
        fail('queue:work needs the Queue module (bin/cms module:add Queue).');
    }

    wire_module_handlers();

    $queue = null;
    $limit = 10;

    foreach (array_slice($argv, 2) as $argument) {
        if (str_starts_with($argument, '--limit=')) {
            $limit = max(1, (int) substr($argument, strlen('--limit=')));
        } elseif (!str_starts_with($argument, '--')) {
            $queue = $argument;
        }
    }

    $result = \Modules\Queue\Interfaces\HTTP\QueueServices::work($queue, $limit);

    out(sprintf(
        'Queue: processed=%d failed=%d (queue: %s, limit %d)',
        $result['processed'],
        $result['failed'],
        $queue ?? '(any)',
        $limit,
    ));

    if ($result['failed'] > 0) {
        out(sprintf(
            'Failed jobs are parked in failed_jobs — retry or drop them at /mark/queue%s.',
            null === $queue ? '' : ' (queue: ' . $queue . ')',
        ));
    }

    exit(\Modules\Queue\Interfaces\HTTP\QueueServices::exitCode($result));
}

/**
 * Drop failed jobs older than an interval — the retention `failed_jobs` never
 * had. Measured on 2026-10-16: four parked rows spanning two hours to a year
 * all survived a worker run, and DatabaseQueue had no prune/clean/purge/expire
 * method at all. The only removal was an operator clicking "drop this job".
 *
 * NOT wired through `wire_module_handlers()`, unlike the two commands above:
 * pruning delivers nothing, and registering a handler map this run will never
 * read would be a lie about what it does — the same line `generate-images`
 * sits on.
 *
 * `--dry-run` reports what WOULD go and deletes nothing, because the thing
 * being deleted is a work queue rather than a log: there is a retry button on
 * each row, and an unattended run that emptied it would report success.
 *
 * @param list<string> $argv
 */
function cmdQueuePrune(array $argv): void
{
    if (!class_exists(\Modules\Queue\Interfaces\HTTP\QueueServices::class)) {
        fail('queue:prune needs the Queue module (bin/cms module:add Queue).');
    }

    $interval = '30 days';
    $dryRun = false;

    foreach (array_slice($argv, 2) as $argument) {
        if (str_starts_with($argument, '--interval=')) {
            $interval = substr($argument, strlen('--interval='));
        } elseif ('--dry-run' === $argument) {
            $dryRun = true;
        } elseif (str_starts_with($argument, '--')) {
            fail('unknown option "' . $argument . '" for queue:prune; known: --interval=, --dry-run');
        } else {
            fail('queue:prune takes options only, got "' . $argument . '"');
        }
    }

    if ('' === trim($interval)) {
        fail('--interval= must not be empty; SQLite would compare against now.');
    }

    $result = \Modules\Queue\Interfaces\HTTP\QueueServices::prune($interval, $dryRun);

    if ($dryRun) {
        out(sprintf(
            'queue:prune --dry-run: %d failed job(s) older than %s would be removed; nothing was.',
            $result['wouldRemove'],
            $result['interval'],
        ));

        return;
    }

    out(sprintf(
        'queue:prune: removed %d failed job(s) older than %s.',
        $result['removed'],
        $result['interval'],
    ));
}

/**
 * Delete the discovery cache — the next request rescans and rebuilds it.
 * The file is derived state (like the migration marker), so clearing it is
 * always safe; a missing file only costs one scan.
 */
function cmdDiscoveryClear(): void
{
    \Discovery\DiscoveryCache::clearCache();
    out('Discovery cache cleared.');
}

/**
 * Report whether the discovery cache exists, whether its fingerprint still
 * matches the current module set, and how many routes it holds.
 */
function cmdDiscoveryStatus(): void
{
    $status = \Discovery\DiscoveryCache::fromAppPaths()->status();

    out(sprintf('Exists:      %s', $status['exists'] ? 'yes' : 'no'));
    out(sprintf('Fresh:       %s', $status['fresh'] ? 'yes' : 'no'));
    out(sprintf('Routes:      %d', $status['routes']));
    out(sprintf('Middleware:  %d', $status['middleware']));
    out(sprintf('Fingerprint: %s', substr($status['fingerprint'], 0, 16) . '…'));
    out(sprintf('Version:     %d', $status['version']));
}

/** @param list<string> $argv */
function main(array $argv): void
{
    $command = $argv[1] ?? '';

    $installer = ModuleInstaller::fromAppPaths();
    $catalog = ModuleCatalog::fromAppPaths();

    switch ($command) {
        case 'module:list':
            cmdList($catalog);

            break;

        case 'module:show':
            cmdShow($catalog, $argv[2] ?? null);

            break;

        case 'module:add':
            if (!isset($argv[2])) {
                fail('module:add needs a module name.');
            }

            cmdAdd($installer, $catalog, $argv[2]);

            break;

        case 'module:remove':
            if (!isset($argv[2])) {
                fail('module:remove needs a module name.');
            }

            cmdRemove($installer, $argv[2], in_array('--force', $argv, true));

            break;

        case 'migrate':
            cmdMigrate();

            break;

        case 'user:admin':
            cmdUserAdmin($argv);

            break;

        case 'settings:profile':
            cmdSettingsProfile($argv);

            break;

        case 'schedule:run':
            cmdScheduleRun();

            break;

        case 'queue:work':
            cmdQueueWork($argv);

            break;

        case 'queue:prune':
            cmdQueuePrune($argv);

            break;

        case 'outbox:process':
            cmdOutboxProcess($argv);

            break;

        case 'generate-images':
            cmdGenerateImages($argv);

            break;

        case 'clickhouse:attach':
            cmdClickhouseAttach($argv);

            break;

        case 'clickhouse:status':
            cmdClickhouseStatus($argv);

            break;

        case 'clickhouse:query':
            cmdClickhouseQuery($argv);

            break;

        case 'discovery:clear':
            cmdDiscoveryClear();

            break;

        case 'discovery:status':
            cmdDiscoveryStatus();

            break;

        default:
            usage();

            exit('' === $command ? 0 : 1);
    }
}

main($argv ?? []);
