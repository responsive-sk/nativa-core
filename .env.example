# Application environment: development | production
#
# This flag also decides where a password reset link goes. The kernel ships no
# mail transport, so:
#   development/local/testing — the dev mailer appends the link (and the plain
#                               text token) to storage/logs/app.log;
#   anything else             — nothing is delivered and nothing is written;
#                               install a transport (a PasswordResetMailer
#                               implementation, picked in
#                               Modules\Users\Infrastructure\Mail\PasswordResetMailerFactory)
#                               to deliver links in production.
APP_ENV=production

# Debug mode — shows detailed error pages (development only)
APP_DEBUG=false

# Application timezone (PHP date_default_timezone_set)
APP_TIMEZONE=Europe/Bratislava

# Admin area URL prefix. Unset means `/mark`, the spelling every route
# attribute declares. Setting it (for example `/admin`) makes that path an
# alias: the panel answers there, the same permission table applies to both
# spellings, and hardcoded `/mark` links keep working. Must be an absolute
# path of plain segments with no trailing slash; a malformed value falls back
# to `/mark` rather than hiding the panel.
# ADMIN_PATH=/admin

# Session configuration
SESSION_NAME=nativa_corenvn
SESSION_LIFETIME=1209600
# Idle session timeout in seconds (default 3600 = 60 min)
SESSION_IDLE_TIMEOUT=3600
# Session cookie Secure flag. When unset it is auto-detected from HTTPS.
# SESSION_SECURE=true

# Log level: debug | info | warn | error
LOG_LEVEL=debug

# Server-side HTML page cache for anonymous public GETs (300 s TTL). OFF by
# default: set `PAGE_CACHE=true` to serve anonymous pages from
# storage/cache/pages. Turning it on buys the TTFB of a file read instead of a
# full theme render; leaving it off keeps every response freshly rendered.
# Content writes flush the cache, so an edit in the admin is visible without
# waiting for the TTL.
# PAGE_CACHE=true

# Password reset delivery (production). Leave all three unset and reset links are
# simply not delivered — the kernel ships no transport, and the dev log is NOT
# used as a fallback outside development. Set them and the reset link is POSTed
# as JSON ({"from", "to", "subject", "text"}) to MAIL_API_URL, which most
# transactional APIs accept; MAIL_API_KEY is optional (same-host relay) and is
# sent as `Authorization: Bearer <key>`.
# APP_URL is the public base URL, used to build the one-click reset link — it is
# required, because the link must not be derived from a Host header a caller can
# forge.
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=re_...
# MAIL_FROM=no-reply@example.com
# APP_URL=https://example.com

# Reverse proxies allowed to set client IP headers (X-Forwarded-For / X-Real-IP).
# Keep EMPTY when the app is directly exposed — forwarded headers are then
# ignored, so clients cannot spoof their IP.
#
# The one deployment this must NOT be left empty in: a reverse proxy on the SAME
# host (nginx/php-fpm) that is not listed here and sets no X-Forwarded-For, so
# every request reaches the app from 127.0.0.1. 127.0.0.1 is the address the
# rate limiters exempt as "the local developer", which would then apply to every
# production request. Either list the proxy here (so the client address in the
# forwarded chain is used) or run the proxy off-host.
TRUSTED_PROXIES=

# Allowed Host header values for absolute URLs (canonical/hreflang/sitemap).
# Comma-separated hostnames (no scheme, no port). Keep EMPTY to accept any Host
# in dev; set it in production.
TRUSTED_HOSTS=

# Databases (optional). Every module owns one database: a SQLite file under
# storage/data/ unless a DSN names a server. The module's database name is the
# catalogue name in upper case — `config` is DB_CONFIG, `users` is DB_USERS.
#
# DB_<NAME>=relative/or/absolute.db   keeps naming the SQLite file (the old
#                                     knob; unset means storage/data/<name>.db)
# DB_<NAME>_DSN=mysql:host=127.0.0.1;port=3306;dbname=nativa_config;charset=utf8mb4
#                                     switches that module to a server
#
# A DSN names the host and the database, never the credentials. DB_<NAME>_USER
# and DB_<NAME>_PASSWORD belong to the module; the shared DB_USER/DB_PASSWORD
# pair is the usual case, because one deployment normally grants one user every
# module database.
# DB_USER=nativa
# DB_PASSWORD=
#
# Only `sqlite:` and `mysql:` are exercised today (`pgsql:` is still a plan). The
# SQLite hardening — busy_timeout, foreign_keys, WAL, query_only on replicas —
# is sent only to a `sqlite:` DSN; a server is hardened by its own configuration,
# and a replica is made read-only through the grant it connects with.
#
# Read replicas are opt-in per module and appended in this order: DB_<NAME>_READ
# still names SQLite files (comma-separated), DB_<NAME>_READ_DSN names server
# replicas with the module's credentials. Reads go to a replica until the
# request writes, then stay on the primary for the rest of it.
# DB_CONFIG_READ=/srv/nativa/config-read.db
# DB_CONFIG_READ_DSN=mysql:host=replica1;dbname=nativa_config;charset=utf8mb4
# DB_READ_STRATEGY=random
# DB_CONFIG_READ_WEIGHTS=70,30

# ClickHouse bridge (optional). Empty CLICKHOUSE_URL leaves the Clickhouse
# module inert: `clickhouse:attach` refuses with "ClickHouse is not configured"
# and nothing contacts a server. Set it to attach the kernel's SQLite files as
# ClickHouse databases through the documented `ENGINE = SQLite(...)`.
#
# The path inside that engine is read ON THE CLICKHOUSE HOST, not in PHP, and
# it must be inside ClickHouse's `user_files` directory (measured 26.11.1.973:
# any other path answers PATH_ACCESS_DENIED). This tree's `storage/data/`
# therefore has to reach that directory under the same absolute path (a bind
# mount or a symlink is the usual answer); a path that works for the kernel can
# still fail on the server. Access control is filesystem permissions — the
# engine has no user or password of its own.
#
# CLICKHOUSE_DATABASE_PREFIX=nativa_
# CLICKHOUSE_CONNECT_TIMEOUT=5
# CLICKHOUSE_TIMEOUT=30
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_URL=http://127.0.0.1:8123
#
# Writes through the bridge lock the whole SQLite file and the kernel's own
# connections use WAL, so `clickhouse:query` is read-only unless `--write`, and
# `attach`/`status` report a non-empty `<file>-wal` instead of hiding it.

# Media remote storage (optional). CLOUDINARY_CLOUD_NAME is the switch: while
# it is empty the media library stays on the local filesystem and the upload
# form offers no provider choice. Setting it makes Cloudinary the default
# provider, shows the Local/Cloudinary radios on the upload form, and adds the
# Cloudinary browser to the media index. A signed upload needs API_KEY and
# API_SECRET as well (UPLOAD_PRESET is the unsigned alternative); the browser
# needs both, and reads only.
#
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=
# CLOUDINARY_FOLDER=nativa-media
