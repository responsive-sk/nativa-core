+    /// The scan surface: a declared scan must answer with a well-formed,
+    /// duplicate-free and reproducible entry set. The wire permits an honest
+    /// typed refusal — a lossy scan must refuse rather than truncate — so
+    /// `unsupported` is accepted as that refusal. Entry paths are deliberately
+    /// not checked against the fixture view: the suite's view is the IR
+    /// fixture, not an enumerable source tree, so a path-existence rule would
+    /// impose a contract the wire does not state.
+    fn scan_phase(&mut self) {
+        use crate::target_protocol::wire::ErrorClass;
+
+        if !self.declared(Operation::Scan) {
+            self.record(CheckOutcome::skipped(
+                CheckId::ScanEntries,
+                "operation-undeclared",
+            ));
+            return;
+        }
+
+        let shape = CallShape {
+            operation: Operation::Scan,
+            profile: self.selected_profile(None),
+            ..CallShape::default()
+        };
+        let response = match self.exchange(&shape) {
+            Exchange::Ok { response, .. } => response,
+            Exchange::Failed(failure) => {
+                let terminal = failure_is_terminal(&failure);
+                self.record_failure(CheckId::ScanEntries, &failure);
+                if terminal {
+                    self.skip_remaining();
+                }
+                return;
+            }
+        };
+
+        if let Some(error) = &response.error {
+            let honest = error.class == ErrorClass::Unsupported;
+            self.record(if honest {
+                CheckOutcome::pass(CheckId::ScanEntries)
+            } else {
+                CheckOutcome::fail(
+                    CheckId::ScanEntries,
+                    CheckId::ScanEntries.class(),
+                    "refusal-class",
+                )
+            });
+            return;
+        }
+
+        let Some(result) = &response.result else {
+            self.record(CheckOutcome::fail(
+                CheckId::ScanEntries,
+                CheckId::ScanEntries.class(),
+                "no-result",
+            ));
+            return;
+        };
+        let Some(entries) = &result.entries else {
+            self.record(CheckOutcome::fail(
+                CheckId::ScanEntries,
+                CheckId::ScanEntries.class(),
+                "no-entries",
+            ));
+            return;
+        };
+        if result.truncated.is_none() {
+            self.record(CheckOutcome::fail(
+                CheckId::ScanEntries,
+                CheckId::ScanEntries.class(),
+                "no-truncated",
+            ));
+            return;
+        }
+        let unique = {
+            let mut seen = std::collections::BTreeSet::new();
+            entries.iter().all(|entry| {
+                seen.insert((
+                    entry.path.as_str(),
+                    entry.kind.as_str(),
+                    entry.detail.as_deref(),
+                ))
+            })
+        };
+        let first = serde_json::to_string(&*response).unwrap_or_default();
+
+        // A second identical scan: an entry set assembled from an unordered
+        // directory walk is the classic source of drift the row exists for.
+        let second = match self.exchange(&shape) {
+            Exchange::Ok { response, .. } => serde_json::to_string(&*response).unwrap_or_default(),
+            Exchange::Failed(failure) => {
+                self.record_failure(CheckId::ScanEntries, &failure);
+                return;
+            }
+        };
+
+        self.record(if !unique {
+            CheckOutcome::fail(
+                CheckId::ScanEntries,
+                CheckId::ScanEntries.class(),
+                "duplicate-entry",
+            )
+        } else if first != second {
+            CheckOutcome::fail(
+                CheckId::ScanEntries,
+                CheckId::ScanEntries.class(),
+                "nondeterministic",
+            )
+        } else {
+            CheckOutcome::pass(CheckId::ScanEntries)
+        });
+    }
