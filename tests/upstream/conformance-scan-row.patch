+#[test]
+fn the_scan_row_runs_when_declared_and_skips_when_not() {
+    // The reference adapter declares `scan.symbols: full` and answers the
+    // exchange, so the row must pass rather than skip: a skip here would mean
+    // the new row measured nothing at all.
+    let declared = run_suite(&adapter_command(&[]), "default");
+    let (state, detail) = check(&declared, "scan.entries");
+    assert_eq!(state, "pass", "{detail:?}");
+
+    // An adapter that drops the operation is skipped, never optimistically
+    // passed: an absent declaration is not evidence of a scan.
+    let undeclared_command =
+        adapter_command(&["--lekalo-adapter-ops", "describe,validate,verify"]);
+    let undeclared = run_suite(&undeclared_command, "default");
+    let (state, detail) = check(&undeclared, "scan.entries");
+    assert_eq!(state, "skipped");
+    assert_eq!(detail, Some("operation-undeclared"));
+}
